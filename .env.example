# Canonical site URL (no trailing slash), used for metadata, sitemap, robots and Open Graph.
# Production: https://whitehilllifecares.com (also the default when unset). Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://whitehilllifecares.com

# Sanity (public dataset; reads need no token)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Server only. Never prefix with NEXT_PUBLIC_.
# Editor token, used only by `npm run seed` on your machine. Not needed on Vercel.
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity webhook -> /api/revalidate.
SANITY_REVALIDATE_SECRET=
